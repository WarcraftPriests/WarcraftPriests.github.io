{
  "name": "warcraftpriests.github.io",
  "version": "1.0.0",
  "type": "module",
  "description": "This is the World of Warcraft Priest Sim Chart website.",
  "main": "index.js",
  "scripts": {
    "copy-highcharts": "node scripts/copyHighcharts.js",
    "build:tailwind": "tailwindcss -i ./css/tailwind.input.css -o ./css/tailwind.generated.css --minify",
    "watch:tailwind": "tailwindcss -i ./css/tailwind.input.css -o ./css/tailwind.generated.css --watch",
    "prepare": "npm run copy-highcharts && npm run build:tailwind",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "start": "npm run build:tailwind && npx http-server -p 8080"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "highcharts": "^13.1.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "@parcel/watcher": "^2.6.0",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.2"
    }
  }
}
